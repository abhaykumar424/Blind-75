class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int temp = 0;
        int maxi = INT_MIN;
        for (int i = 0; i < nums.size(); i++) {
            temp += nums[i];
            maxi = max(maxi, temp);
            if (temp < 0)
                temp = 0;
        }
        return maxi;
    }
};