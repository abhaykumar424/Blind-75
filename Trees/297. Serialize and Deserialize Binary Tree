/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode(int x) : val(x), left(NULL), right(NULL) {}
 * };
 */
class Codec {
public:
    // Encodes a tree to a single string.
    string encode(TreeNode* root, string& str) {
        if (root == nullptr) {
            str += "# ";
            return str;
        }
        str += to_string(root->val) + " ";
        encode(root->left, str);
        encode(root->right, str);
        return str;
    }
    string serialize(TreeNode* root) {
        string str;
        encode(root, str);
        return str;
    }

    // Decodes your encoded data to tree.
    TreeNode* decode(istringstream& in) {
        string token;
        if (!(in >> token))
            return nullptr;
        if (token == "#")
            return nullptr;

        TreeNode* temp = new TreeNode(stoi(token));
        temp->left = decode(in);
        temp->right = decode(in);
        return temp;
    }
    TreeNode* deserialize(string data) {
        istringstream in(data);
        return decode(in);
    }
};

