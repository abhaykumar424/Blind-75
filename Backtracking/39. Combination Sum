class Solution {
public:
    void dfs(vector<int>& candidates, int target, vector<vector<int>>& ans,
             vector<int>& subset, int sum, int i) {
        if (sum == target) {
            ans.push_back(subset);
            return;
        }
        if (i >= candidates.size() || sum > target) {
            return;
        }
        subset.push_back(candidates[i]);
        dfs(candidates, target, ans, subset, sum + candidates[i], i);
        subset.pop_back();
        dfs(candidates, target, ans, subset, sum, i + 1);
    }
    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        vector<vector<int>> ans;
        vector<int> subset;

        int sum = 0;
        int i = 0;
        dfs(candidates, target, ans, subset, sum, i);
        return ans;
    }
};