class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        unordered_set<int>st(nums.begin(), nums.end());

        int longest = 0;

        for(auto it : st){
            if(st.find(it-1)==st.end()){
                int num = it;
                int length = 1;
                while(st.find(num+1)!=st.end()){
                    num++;
                    length++;
                }
                longest = max(length, longest);
            }
        }
        return longest;
    }
};