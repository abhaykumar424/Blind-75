class Solution {
public:

    string encode(vector<string>& strs) {
        string str ;
        for(int i=0; i<strs.size(); i++){
            int n = strs[i].size();
            str += to_string(n) + '#' + strs[i];
        }
        return str;
    }

    vector<string> decode(string s) {
        vector<string>ans;
        int i = 0;
        while(i<s.size()){
            int j = i;
            while(s[j]!='#'){
                j++;
            }
            int check = stoi(s.substr(i, j-i));
            j++;
            string temp = s.substr(j, check);
            ans.push_back(temp);
            i = j+check;
        }
        return ans;
    }
};
