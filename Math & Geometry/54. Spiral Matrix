class Solution {
public:
    vector<int> spiralOrder(vector<vector<int>>& matrix) {
        vector<int> ans;
        int m = matrix.size();
        int n = matrix[0].size();

        int sR = 0;
        int eR = m - 1;

        int sC = 0;
        int eC = n - 1;

        while (sR <= eR && sC <= eC) {
            for (int i = sC; i <= eC; i++) {
                ans.push_back(matrix[sR][i]);
            }
            sR++;

            for (int i = sR; i <= eR; i++) {
                ans.push_back(matrix[i][eC]);
            }
            eC--;

            if (sR > eR || sC > eC)
                break;

            for (int i = eC; i >= sC; i--) {
                ans.push_back(matrix[eR][i]);
            }
            eR--;
            for (int i = eR; i >= sR; i--) {
                ans.push_back(matrix[i][sC]);
            }
            sC++;
        }

        return ans;
    }
};